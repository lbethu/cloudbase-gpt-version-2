# ── CloudBase AI server configuration ─────────────────────────────────────────
# Copy to .env.local. Never commit real values. All variables are read only in
# src/server/config.ts; nothing here is exposed to the browser.

# Identity ────────────────────────────────────────────────────────────────────
# dev   → development identity (refused in production builds)
# entra → Microsoft Entra ID via authenticating proxy (App Service Easy Auth /
#         Front Door) that injects x-ms-client-principal and STRIPS it inbound
# none  → no identity; the app renders the sign-in-required boundary
# dev    → development identity (refused in production builds)
# access → Cloudflare Access in front of the app (verified JWT + content/registry/people.yaml)
# entra  → Microsoft Entra ID via an authenticating proxy
CLOUDBASE_AUTH_MODE=dev

# Cloudflare Access (CLOUDBASE_AUTH_MODE=access). The AUD tag comes from the
# Access application; the team domain is <team>.cloudflareaccess.com.
# Who may sign in is content/registry/people.yaml — an unlisted person is refused.
CLOUDBASE_ACCESS_TEAM_DOMAIN=
CLOUDBASE_ACCESS_AUD=
CLOUDBASE_TENANT_ID=cloudpoint
# Development identity (dev mode only)
CLOUDBASE_DEV_USER_NAME=Development User
CLOUDBASE_DEV_USER_EMAIL=dev@cloudpoint.local
CLOUDBASE_DEV_USER_ROLES=employee,contributor,reviewer,approver,ai-steward,admin,sales-manager
CLOUDBASE_DEV_USER_TEAMS=company-wide,ai-automation
# Entra group object id → CloudBase role / team (JSON maps)
CLOUDBASE_ENTRA_GROUP_ROLE_MAP={}
CLOUDBASE_ENTRA_GROUP_TEAM_MAP={}

# AI provider (optional — the platform is fully useful with AI disabled) ─────
# disabled | openai | azure-openai | anthropic | gemini
CLOUDBASE_AI_PROVIDER=disabled
CLOUDBASE_AI_MODEL=
CLOUDBASE_AI_API_KEY=
CLOUDBASE_AI_BASE_URL=
CLOUDBASE_AI_AZURE_DEPLOYMENT=

# Search provider: lexical (default) | hybrid (vector seam, requires configuration)
CLOUDBASE_SEARCH_PROVIDER=lexical

# Database (optional — the file registry is the default) ─────────────────────
# CLOUDBASE_STORAGE=file      git-versioned content/ (the default, no infrastructure needed)
# CLOUDBASE_STORAGE=postgres  serve and write governed records from PostgreSQL
# DATABASE_URL alone does NOT switch storage — set it, migrate and seed first,
# then opt in with CLOUDBASE_STORAGE=postgres.
# Free managed options: Neon (neon.tech) or Supabase (supabase.com).
#   npm run db:migrate   apply /drizzle migrations
#   npm run db:seed      load content/ into the database (idempotent)
# CLOUDBASE_STORAGE=postgres
DATABASE_URL=
# Throwaway database used by the optional postgres test suite
CLOUDBASE_TEST_DATABASE_URL=

# Document blob storage — local filesystem by default, S3-compatible when set.
# Works with AWS S3, Cloudflare R2, Supabase Storage and MinIO.
# CLOUDBASE_BLOB_STORAGE=local | s3   (explicit; S3_BUCKET alone does not switch)
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto",
# force path style true. npm run blob:upload copies existing documents into the bucket.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Storage locations (defaults shown)
# CLOUDBASE_CONTENT_DIR=./content
# CLOUDBASE_SOURCE_DOCUMENTS_DIR=./source-documents
# CLOUDBASE_AUDIT_DIR=./var/audit

# Largest document the upload workflow accepts (MB). Serverless platforms cap the
# request body lower than this and reject it before the app sees it — on Vercel
# set 4, because its functions stop at 4.5 MB.
CLOUDBASE_MAX_UPLOAD_MB=25

# Legacy prototype UI (/legacy, /presentation). Default: on outside production.
CLOUDBASE_ENABLE_LEGACY_PROTOTYPE=true

# Google Drive live search (optional) — see docs/google-drive-integration.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_IDS=

# GitHub (read-only). Public repos work without a token; set for private repos / rate limits.
CLOUDBASE_GITHUB_ENABLED=true
GITHUB_TOKEN=

# Pipedrive CRM connector (read-only). Company domain = the part before .pipedrive.com
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# Footer / sidebar credit
CLOUDBASE_DEVELOPER_CREDIT=Cloudpoint
