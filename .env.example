# Google Drive live-search integration.
# Full setup walkthrough: docs/google-drive-integration.md
# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.

# Service account email, e.g. cloudbase-drive-search@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key from the service account's downloaded JSON key file.
# Keep it on one line and escape real newlines as \n (this app unescapes
# them at runtime). Wrap the whole value in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# Optional: comma-separated Google Drive folder IDs to restrict search scope
# (the folder ID is the part of the folder's URL after /folders/).
# Leave blank to search everything already shared with the service account.
GOOGLE_DRIVE_ROOT_FOLDER_IDS=
